{
  "pluginAlias": "MovaVacuum",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "MOVA E40 Ultra mit Homebridge und Apple Home verbinden.",
  "footerDisplay": "Die Zugangsdaten werden ausschließlich für die Anmeldung an der MOVA-Cloud verwendet. Gib dein Passwort niemals in Protokollen oder Supportanfragen weiter.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Plugin-Name",
        "type": "string",
        "default": "MOVA",
        "description": "Name der MOVA-Integration in Homebridge."
      },
      "username": {
        "title": "MOVA-E-Mail-Adresse",
        "type": "string",
        "format": "email",
        "placeholder": "name@beispiel.de",
        "description": "E-Mail-Adresse, mit der du dich in der MOVAhome-App anmeldest."
      },
      "password": {
        "title": "MOVA-Passwort",
        "type": "string",
        "description": "Passwort deines MOVAhome-Kontos.",
        "x-schema-form": {
          "type": "password"
        }
      },
      "roomCatalog": {
        "title": "Erkannte MOVA-Räume",
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 61
            },
            "name": {
              "type": "string"
            },
            "mapId": {
              "type": "integer"
            }
          },
          "required": [
            "id",
            "name",
            "mapId"
          ]
        }
      },
      "presets": {
        "title": "Reinigungspresets",
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "oneOf": [
                {
                  "title": "Individuelle MOVA-Raumeinstellungen",
                  "const": "automatic"
                },
                {
                  "title": "Saugen",
                  "const": 0
                },
                {
                  "title": "Wischen",
                  "const": 1
                },
                {
                  "title": "Saugen und Wischen",
                  "const": 2
                },
                {
                  "title": "Wischen nach dem Saugen",
                  "const": 3
                }
              ]
            },
            "rooms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "roomId": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 61
                  },
                  "roomName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cleaningTimes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3,
                    "default": 1
                  },
                  "suctionLevel": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3,
                    "default": 0
                  },
                  "waterVolume": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2,
                    "default": 0
                  }
                },
                "required": [
                  "roomId",
                  "roomName",
                  "cleaningTimes",
                  "suctionLevel",
                  "waterVolume"
                ]
              }
            }
          },
          "required": [
            "id",
            "name",
            "mode",
            "rooms"
          ]
        }
      }
    },
    "required": [
      "name",
      "username",
      "password"
    ]
  }
}
